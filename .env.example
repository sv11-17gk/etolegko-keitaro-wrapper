# --- Keitaro ---
# Корень домена трекера (без /admin_api/v1 — клиент добавит путь сам)
KT_BASE_URL=https://in.posdk.xyz
# API ключ из админки Keitaro: Профиль -> API ключи -> Создать новый ключ
KT_API_KEY=
# База админки для кнопки VIEW IN KT (по умолчанию — origin из KT_BASE_URL)
KT_ADMIN_URL=

# --- БД обёртки ---
DATABASE_URL=sqlite:///./wrapper.db
# для PostgreSQL: postgresql+psycopg2://user:pass@host:5432/wrapper

# --- Значения схем/действий потоков (сверить с живым KT, см. README «Допущения») ---
KT_REDIRECT_SCHEMA=action
KT_REDIRECT_ACTION=redirectToUrl
KT_OFFERS_SCHEMA=offers
KT_OFFERS_ACTION=showOffers

# URL редиректа Flow 1 и длина alias кампании
FLOW1_URL=https://google.com
ALIAS_LENGTH=6
