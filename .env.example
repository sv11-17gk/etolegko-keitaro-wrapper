# --- Keitaro ---
# Корень домена трекера (без /admin_api/v1 — клиент добавит путь сам)
KT_BASE_URL=https://your-keitaro.example
# API ключ из админки Keitaro: Профиль -> API ключи -> Создать новый ключ
KT_API_KEY=
# База админки для VIEW IN KT (по умолчанию — KT_BASE_URL/admin/#!)
KT_ADMIN_URL=

# --- БД обёртки ---
DATABASE_URL=sqlite:///./wrapper.db
DEMO_MODE=false
# для PostgreSQL: postgresql+psycopg2://user:pass@host:5432/wrapper

# --- Схемы/действия потоков, проверенные на живом Keitaro ---
KT_REDIRECT_SCHEMA=redirect
KT_REDIRECT_ACTION=http
KT_OFFERS_SCHEMA=landings
KT_OFFERS_ACTION=http

# URL редиректа Flow 1 и длина alias кампании
FLOW1_URL=https://google.com
ALIAS_LENGTH=6
